# 可留空：默认使用本地 SQLite、MockAdapter，不调用任何外部模型。
# DATABASE_URL=postgresql+asyncpg://teamcode:teamcode@localhost:5432/teamcode

# 真实 Coding Agent：服务器配置 argv；页面只能选择已配置的名称。
# Claude Code 需要预先安装并登录；仅开放文件工具，测试由平台执行。
# TEAMCODE_AGENTS={"claude":{"command":["claude","--print","--tools","Read,Write,Edit","--allowedTools","Read,Write,Edit","--no-session-persistence","--max-budget-usd","2","--model","sonnet","--output-format","text"],"prompt_mode":"stdin","timeout":240}}

# OpenAI-compatible 语义说明服务；BASE_URL 包含 /v1，不包含 /chat/completions。
# TEAMCODE_LLM_BASE_URL=https://your-provider.example/v1
# TEAMCODE_LLM_API_KEY=
# TEAMCODE_LLM_MODEL=
# TEAMCODE_LLM_AUTO=1
