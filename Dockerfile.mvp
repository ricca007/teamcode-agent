FROM node:22-alpine AS web
WORKDIR /ui
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/ backend/
RUN pip install --no-cache-dir -e './backend[dev]' -r backend/requirements-interfaces.txt
COPY cli/ cli/
COPY scripts/run_mvp.py scripts/run_mvp.py
COPY examples/ examples/
COPY --from=web /ui/dist frontend/dist/
ENV PYTHONUTF8=1 PYTHONUNBUFFERED=1
CMD ["python", "scripts/run_mvp.py", "--host", "0.0.0.0"]
