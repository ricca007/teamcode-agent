POSTGRES_DB=teamcode
POSTGRES_USER=teamcode
POSTGRES_PASSWORD=teamcode
DATABASE_URL=postgresql+asyncpg://teamcode:teamcode@db:5432/teamcode

# 鉴权：开启时必须设置一个足够长的随机 secret（默认值会被拒绝）。
# 本地调试若想跳过鉴权，可改为 TEAMCODE_REQUIRE_AUTH=0。
TEAMCODE_REQUIRE_AUTH=1
TEAMCODE_AUTH_SECRET=change-me-to-a-long-random-string
